#!/bin/bash
# Pre-commit hook: prevent accidental commit of Secrets.xcconfig or .env with real keys
set -e
if git diff --cached --name-only | grep -q "Config/Secrets.xcconfig"; then
  echo "ERROR: Config/Secrets.xcconfig is staged — it contains secrets and is gitignored. Unstage it: git restore --staged Config/Secrets.xcconfig"
  exit 1
fi
if git diff --cached --name-only | grep -q "^\.env$"; then
  # Allow .env.example but not .env
  echo "ERROR: .env is staged — it may contain secrets. Unstage it: git restore --staged .env"
  exit 1
fi
# Also block Klipy key in diff
if git diff --cached | grep -q "KLIPY_API_KEY.*[A-Za-z0-9]\{20,\}"; then
  echo "WARNING: staged diff contains a potential KLIPY_API_KEY value — verify it is not a real key."
fi
exit 0
